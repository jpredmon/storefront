<!DOCTYPE html>
<html>
  <head>
    <title>StoreFront</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <%# Third-party scripts go in <head>: Turbo keeps <head> scripts across visits but re-evaluates <body> scripts on each render. %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
  </head>
  <body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
      <div class="container">
        <%= link_to "StoreFront", root_path, class: "navbar-brand fw-bold" %>
        <%= link_to cart_path, class: "btn btn-outline-light btn-sm ms-auto" do %>
          Cart (<%= cart.count %>)
        <% end %>
      </div>
    </nav>

    <div class="container mt-4">
      <% flash.each do |type, message| %>
        <% css = type.to_s == "notice" ? "alert-success" : "alert-danger" %>
        <div class="alert <%= css %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <footer class="text-center text-muted py-4 mt-5 border-top">
      <small>
        &copy; <%= Date.current.year %> StoreFront &middot;
        <%= link_to "Admin", new_admin_admin_user_session_path, class: "text-muted" %>
      </small>
    </footer>
  </body>
</html>
